# backend/.env.example
# Copier ce fichier en ".env" et remplir avec de VRAIES valeurs.
# NE JAMAIS committer le fichier ".env" (voir .gitignore).

# --- Gemini ---
GEMINI_API_KEY=

# --- CinetPay ---
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# --- Firebase Admin (contenu JSON complet du compte de service, sur une seule ligne) ---
FIREBASE_SERVICE_ACCOUNT=

# --- App ---
# URL publique du frontend déployé (utilisée pour CORS et les URLs de retour CinetPay)
APP_BASE_URL=https://votre-frontend.example.com
PORT=3000
